# Copy this file to .env locally. Never commit the real .env.
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=eu-north-1

# DMI API key. This is separate from AWS credentials.
DMI_API_KEY=replace-with-dmi-api-key

# Optional project configuration
DMI_BUCKET=tica93-dmi-all-stations
RADAR_BUCKET=tica93-dmi-radar-cache
REGRESSION_BUCKET=tica93-dmi-all-stations-regresion
